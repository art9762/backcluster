+            (uint64_t) pos0 + n_tok > n_ctx_) throw std::runtime_error("stage chunk position or size mismatch");
+        const size_t count = (size_t) n_tok * n_embd_;
+        chunk_req3 q = { { pos0, (uint32_t) n_tok, resid_f32 ? DT_F32 : DT_F16, logits ? 1u : 0u }, epoch_, id };
+        std::vector<ggml_fp16_t> half;
+        if (!resid_f32) { half.resize(count); ggml_fp32_to_fp16_row(data, half.data(), (int64_t) count); }
+        send_msg(fd_, MSG_STAGE_CHUNK, &q, sizeof(q), resid_f32 ? (const void *) data : (const void *) half.data(), count * (resid_f32 ? 4 : 2));
+        const bool middle = hello.flags == STAGE_RESIDUAL;
+        const size_t expected = middle ? count : logits ? n_vocab_ : 0;
+        auto payload = receive(MSG_STAGE_CHUNK_ACK, sizeof(chunk_rep3) + expected * sizeof(float));
+        if (payload.size() != sizeof(chunk_rep3) + expected * sizeof(float)) throw std::runtime_error("bad stage CHUNK size");
+        chunk_rep3 r; memcpy(&r, payload.data(), sizeof(r));
+        if (r.base.status || r.base.n_tok != (uint32_t) n_tok || r.base.n_logits != (middle ? 0 : expected) ||
+            r.n_residual != (middle ? count : 0) || r.dtype != DT_F32 || r.epoch != epoch_ || r.request_id != id ||
+            r.n_valid != (uint32_t) pos0 + n_tok) throw std::runtime_error("stage CHUNK identity or shape mismatch");
+        std::vector<float> output(expected);
+        if (expected) memcpy(output.data(), payload.data() + sizeof(r), expected * sizeof(float));
+        n_valid_ = r.n_valid; last_ms = r.base.compute_ms;
+        return output;
+    }
+
+    uint32_t n_valid() const { return n_valid_; }
+    void trim(uint32_t n) {
+        send_msg(fd_, MSG_TRIM, &n, sizeof(n));
+        auto p = receive(MSG_OK, sizeof(uint32_t));
+        if (p.size() != sizeof(uint32_t)) throw std::runtime_error("bad stage TRIM size");
+        memcpy(&n_valid_, p.data(), sizeof(n_valid_));
+    }
+
+private:
+    int fd_ = -1;
+    uint32_t n_valid_ = 0, n_embd_ = 0, n_vocab_ = 0, n_ctx_ = 0, n_ubatch_ = 0;
+    uint64_t epoch_ = 0;
+    std::vector<uint8_t> receive(uint32_t expected, size_t max_bytes) {
+        auto h = recv_hdr(fd_);
+        if (h.type == MSG_ERR) {
+            if (h.len > 4096) throw std::runtime_error("oversize stage error");
+            std::string e(h.len, '\0'); if (h.len) recv_all(fd_, e.data(), h.len);
+            throw std::runtime_error("stage worker: " + e);
+        }
+        if (h.type != expected || h.len > max_bytes) throw std::runtime_error("unexpected stage reply type or size");
+        std::vector<uint8_t> p(h.len); if (h.len) recv_all(fd_, p.data(), p.size()); return p;
+    }
+};
+
+// Two bounded queues let head, middle and tail process different ubatches at once.
+class pipeline_client {
+public:
+    stage_client middle, tail;
+    ~pipeline_client() { abort_link(); }
+
+    void start() {
+        middle_thread_ = std::thread([this] { run(true); });
+        tail_thread_ = std::thread([this] { run(false); });
+    }
+    void submit_chunk(const float * data, int n_tok, int n_embd, int pos0, bool logits, std::function<bool()> canceled = {}) {
+        std::unique_lock<std::mutex> lock(mu_);
+        while (!stop_ && submitted_ - completed_ >= 3) {
+            if (canceled && canceled()) { lock.unlock(); abort_link(); throw std::runtime_error("split decode canceled"); }
+            cv_.wait_for(lock, std::chrono::milliseconds(20));
+        }
+        if (stop_) throw std::runtime_error(error_.empty() ? "pipeline stopped" : error_);
+        item q; q.data.assign(data, data + (size_t) n_tok * n_embd); q.n_tok = n_tok; q.pos0 = pos0;
+        q.logits = logits; q.id = ++submitted_; head_.push_back(std::move(q)); cv_.notify_all();
+    }
+    bool finish(std::vector<float> & logits, std::string & error, std::function<bool()> canceled = {}) {
+        std::unique_lock<std::mutex> lock(mu_);
+        while (!stop_ && completed_ != submitted_) {
+            if (canceled && canceled()) { error = "split decode canceled"; lock.unlock(); abort_link(); return false; }
+            cv_.wait_for(lock, std::chrono::milliseconds(20));
+        }
+        if (stop_) { error = error_; return false; }
+        logits = std::move(logits_); logits_.clear(); return true;
+    }
+    uint32_t n_valid() const {
+        if (middle.n_valid() != tail.n_valid()) throw std::runtime_error("pipeline stage watermarks differ");
+        return tail.n_valid();
+    }
+    void trim(uint32_t n) {
+        middle.trim(n); tail.trim(n);
+        if (middle.n_valid() != tail.n_valid()) throw std::runtime_error("pipeline TRIM watermarks differ");
+    }
+    void abort_link() {
+        { std::lock_guard<std::mutex> lock(mu_); stop_ = true; }
+        middle.abort(); tail.abort(); cv_.notify_all();
+        if (middle_thread_.joinable()) middle_thread_.join();
+        if (tail_thread_.joinable()) tail_thread_.join();
+    }
+private:
+    struct item { std::vector<float> data; int n_tok = 0, pos0 = 0; bool logits = false; uint64_t id = 0; };
+    mutable std::mutex mu_;
+    std::condition_variable cv_;
+    std::deque<item> head_, downstream_;
+    std::thread middle_thread_, tail_thread_;
+    bool stop_ = false;
+    uint64_t submitted_ = 0, completed_ = 0;
+    std::string error_;
+    std::vector<float> logits_;
+    void run(bool first) {
+        try {
+            while (true) {
+                item q;
+                {
+                    std::unique_lock<std::mutex> lock(mu_);
+                    auto & queue = first ? head_ : downstream_;
+                    cv_.wait(lock, [&] { return stop_ || !queue.empty(); });
+                    if (stop_) return;
+                    q = std::move(queue.front()); queue.pop_front();
+                }
+                auto output = (first ? middle : tail).chunk(q.data.data(), q.n_tok, q.pos0, !first && q.logits, q.id);
+                {
+                    std::lock_guard<std::mutex> lock(mu_);
+                    if (stop_) return;
+                    if (first) { q.data = std::move(output); downstream_.push_back(std::move(q)); }
+                    else { if (q.logits) logits_ = std::move(output); completed_++; }
+                }
+                cv_.notify_all();
+            }
+        } catch (const std::exception & e) {
+            { std::lock_guard<std::mutex> lock(mu_); if (error_.empty()) error_ = e.what(); stop_ = true; }
+            middle.abort(); tail.abort(); cv_.notify_all();
+        }
+    }
+};
+} // namespace spt
